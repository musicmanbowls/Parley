<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!-- Portable debug metadata must not disclose the developer's filesystem. -->
    <PathMap>$(MSBuildProjectDirectory)=/_/Parley</PathMap>
    <Deterministic>true</Deterministic>
    <Authors>MusicManBowls</Authors>
    <Company></Company>
    <Version>1.0.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Description>A tabbed messenger for tells, your free company, linkshells and cross-world linkshells, with per-conversation history, unread counts and an optional Umbra toolbar widget.</Description>
    <!-- One place for the built plugin whichever way it is built: the solution
         builds it as x64, which would otherwise put it in bin\x64\Debug. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <PackageProjectUrl>https://github.com/musicmanbowls/Parley</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <!-- Dalamud shows this beside the plugin once it is installed. -->
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
